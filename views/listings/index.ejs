<% layout("layouts/boilerplate.ejs") %>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
        }

        .filter {
            text-align: center;
            margin: 0.35rem;
            margin-right: 2rem;
            margin-top: 1.5rem;
            opacity: 0.7;
            text-decoration: none;
            color: inherit;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        #filters .filter p {
            font-size: 0.6rem;
        }

        .tax-info {
            display: none;
        }

        .tax-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid rgb(194, 82, 48);
            border-radius: 1rem;
            height: 2.4rem;
            padding-bottom: .2rem;
            padding-left: .3rem;
            padding-right: .3rem;
            margin-top: 1.5rem;
            margin-left: 3rem;

        }
    </style>

    <body>
        <!-- <h2 style="text-align: center;">All Listings</h2> -->
        <!-- <form action="/listings/new" method="get">
            <button>Add Your Listing</button>
        </form> -->
        <!-- Filters toggle button for small screens -->
        <button class="btn btn-outline-dark d-md-none my-2" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse">
            <i class="fa-solid fa-filter"></i> Filters
        </button>

        <!-- Filters collapsible container -->
        <div class="collapse d-md-block" id="filtersCollapse">
            <div id="filters">
                <a href="/listings?category=Trending" class="filter">
                    <i class="fa-solid fa-fire"></i>
                    <p>Trending</p>
                </a>
                <a href="/listings?category=Amazing Pools" class="filter">
                    <i class="fa-solid fa-person-swimming"></i>
                    <p>Amazing Pools!</p>
                </a>
                <a href="/listings?category=Iconic Cities" class="filter">
                    <i class="fa-solid fa-city"></i>
                    <p>Iconic Cities</p>
                </a>
                <a href="/listings?category=Rooms" class="filter">
                    <i class="fa-solid fa-bed"></i>
                    <p>Rooms</p>
                </a>
                <a href="/listings?category=Cabins" class="filter">
                    <i class="fa-solid fa-house-chimney-window"></i>
                    <p>Cabins</p>
                </a>
                <a href="/listings?category=Camping" class="filter">
                    <i class="fa-solid fa-tent"></i>
                    <p>Camping</p>
                </a>
                <a href="/listings?category=Amazing Views" class="filter">
                    <i class="fa-solid fa-person-through-window"></i>
                    <p>Amazing Views!</p>
                </a>
                <a href="/listings?category=Lakefront" class="filter">
                    <i class="fa-solid fa-home"></i>
                    <p>Lakefront</p>
                </a>
                <a href="/listings?category=Castles" class="filter">
                    <i class="fa-brands fa-fort-awesome"></i>
                    <p>Castles</p>
                </a>
                <a href="/listings?category=Farms" class="filter">
                    <i class="fa-solid fa-cow"></i>
                    <p>Farms</p>
                </a>
                <a href="/listings?category=Food" class="filter">
                    <i class="fa-solid fa-utensils"></i>
                    <p>Food</p>
                </a>
                <a href="/listings?category=Arctic" class="filter">
                    <i class="fa-solid fa-igloo"></i>
                    <p>Arctic</p>
                </a>

                <div class="tax-toggle">
                    <div class="form-check-reverse form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                        <label class="form-check-label" for="switchCheckDefault">Display all prices inlcuding taxes</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% if (alllistings.length === 0) { %>
                <div class="col-12 text-center mt-4">
                    <p class="text-muted">No listings found!</p>
                </div>
            <% } %>
            <% for(let listing of alllistings) {%>
                <a href="/listings/<%= listing._id %>" class="show">
                    <div class="card mb-3 listing-card" style="max-width: 640px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="<%= listing.image.url %>" class=" rounded-start object-fit-cover h-100"
                                    alt="listing_image" style="width: 9.4rem !important;" />
                                <div class="card-img-overlay"></div>
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <b>
                                            <%= listing.title %>
                                        </b>
                                    </h5>
                                    <p class="card-text">
                                        <%= listing.description %>
                                    </p>
                                    <p class="card-text"><small class="text-body-secondary"><b>&#8377;<%=
                                                    listing.price.toLocaleString("en-IN") %></b>/Night</small> <i
                                            style="color: coral;" class="tax-info">+ <b>18%GST</b></i></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>




        <script>
            let checkboxes = document.getElementById("switchCheckDefault");

            checkboxes.addEventListener("click", () => {
                let taxInfo = document.getElementsByClassName("tax-info");
                for (info of taxInfo) {
                    if (info.style.display != "inline") {
                        info.style.display = "inline";
                    } else {
                        info.style.display = "none";
                    }
                }
            });
        </script>