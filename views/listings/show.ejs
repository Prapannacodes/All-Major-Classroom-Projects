<% layout("layouts/boilerplate.ejs") %>
    <script>
        const mapToken = "<%= process.env.Map_Token %>";
        const Listing = <%- JSON.stringify(Listing) %>;
        const coordinate = <%- JSON.stringify(Listing.geometry.coordinates) %>;
    </script>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h4 style="text-align: center;"><b>
                    <%= Listing.title %>
                </b></h4>
            <div class="card listing-card">
                <img src="<%= Listing.image.url %>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">

                    <p class="card-text">
                    <h6><i>Hosted by <%= Listing.owner.username %></i></h6>
                    <b>
                        <%= Listing.description %>
                    </b>
                    </p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <%= Listing.location %>
                    </li>
                    <li class="list-group-item">
                        <%= Listing.country %>
                    </li>
                    <li class="list-group-item"><b>&#8377;<%= Listing.price.toLocaleString("en-IN") %></b></li>
                    <!-- tolocalestring func puts commas in price  -->
                </ul>
                <% if(currUser && currUser._id.equals(Listing.owner._id)) { %>
                    <div class="card-body">
                        <a href="/listings/<%= Listing._id %>/edit" class="card-link btn btn-dark clr">Edit Details</a>
                        <br> <br>
                        <form action="/listings/<%= Listing._id %>?_method=DELETE" method="post">
                            <button class="btn btn-dark clr">Delete</button>
                        </form>
                    </div>
                    <% } %>
                        <hr>
                        <div class="col-8 offset-2 mb-3">
                            <h4>Leave a Review</h4>
                            <form action="/listings/<%= Listing._id %>/reviews" method="post" novalidate
                                class="needs-validation">
                                <div class="form-group" class="mb-3 mt-3">
                                    <label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-heartbeat">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                            value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>
                                <div class="form-group" class="mb-3 mt-3">
                                    <label for="comment" class="form-label">Comment</label>
                                    <textarea class="form-control" id="comment" name="review[comment]" rows="3"
                                        required></textarea>
                                    <div class="invalid-feedback">*Required</div>
                                </div>
                                <button type="submit" class="btn btn-outline-dark mt-3">Submit</button>
                            </form>
                            <hr>
                            <% if (Listing.reviews.length> 0) { %>
                                <div class="row">
                                    <h4>All Reviews</h4>
                                    <% if (Listing.reviews.length) { %>
                                        <% for (let review of Listing.reviews) { %>
                                            <div class="card col-5 mb-3 ms-3">
                                                <div class="card-body">
                                                    <h5 class="card-title"><b>
                                                            <%= review.author.username %>
                                                        </b></h5>
                                                    <p class="starability-result" data-rating="<%= review.rating %>">
                                                        Rated: <%= review.rating %> stars
                                                    </p>
                                                    <p class="card-text">Comment: <%= review.comment %>
                                                    </p>
                                                </div>
                                                <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                                    <form class="mb-3"
                                                        action="/listings/<%= Listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                        method="post">
                                                        <button type="submit" class="btn btn-dark mt-3"
                                                            style="background-color: orangered; border-color: orangered;">Delete</button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                            <% } %>
                                                <% } else { %>
                                                    <p>No reviews yet.</p>
                                                    <% } %>
                                </div>
                                <% } %>
                        </div>
                        <div class="col-8 offset-2 mb-3">
                            <h4>Where is your place?</h4>
                            <div id="map"></div>
                        </div>
            </div>
        </div>
        <script src="/js/map.js"></script>