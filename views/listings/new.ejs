<% layout("layouts/boilerplate.ejs") %>
    <div class="row mt-3">
        <div class="col-7 offset-3">
            <!-- <br> <br> -->
            <h2>Enter Details</h2>
            <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3 ">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" class="form-control" id="exampleFormControlInput1" name="listing[title]"
                        placeholder="Enter Title" required>
                    <div class="invalid-feedback">*Required</div>
                </div>
                <div class="mb-3 ">
                    <label for="textarea" class="form-label">Description</label>
                    <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" name="listing[description]"
                        placeholder="Enter Description" required></textarea>
                    <div class="invalid-feedback">*Required</div>
                </div>

                <div class="mb-3 ">
                    <label for="image" class="form-label">Upload Image</label>
                    <input type="file" class="form-control" id="exampleFormControlInput1" name="listing[image]"
                        required>
                    <div class="invalid-feedback">*Image is required</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-3">
                        <label for="location" class="form-label">Enter Location</label>
                        <input type="text" class="form-control" id="exampleFormControlInput1" name="listing[location]"
                            placeholder="Enter Location" required>
                        <div class="invalid-feedback">*Required</div>
                    </div>
                    <div class="mb-3 col-md-5">
                        <label for="country" class="form-label">Enter Country</label>
                        <input type="text" class="form-control" id="exampleFormControlInput1" name="listing[country]"
                            placeholder="Enter Country" required>
                        <div class="invalid-feedback">*Required</div>
                    </div>

                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Enter price</label>
                    <input class="form-control" id="exampleFormControlInput1" name="listing[price]"
                        placeholder="Enter Price" style="width: 400px !important;" required>
                    <div class="invalid-feedback">*Enter Valid Price</div>
                    <!-- remember before deploying to add type="number"  -->
                </div>
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            Select Categories
                        </button>
                        <div class="dropdown-menu w-100 p-3" style="max-height: 200px; overflow-y: auto;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Trending" id="trending">
                                <label class="form-check-label" for="trending">Trending</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Amazing Pools" id="pools">
                                <label class="form-check-label" for="pools">Amazing Pools</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Iconic Cities" id="cities">
                                <label class="form-check-label" for="cities">Iconic Cities</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Rooms" id="rooms">
                                <label class="form-check-label" for="rooms">Rooms</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Cabins" id="cabins">
                                <label class="form-check-label" for="cabins">Cabins</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Camping" id="camping">
                                <label class="form-check-label" for="camping">Camping</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Amazing Views" id="views">
                                <label class="form-check-label" for="views">Amazing Views</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Lakefront" id="lakefront">
                                <label class="form-check-label" for="lakefront">Lakefront</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Castles" id="castles">
                                <label class="form-check-label" for="castles">Castles</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Farms" id="farms">
                                <label class="form-check-label" for="farms">Farms</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Food" id="food">
                                <label class="form-check-label" for="food">Food</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="Arctic" id="arctic">
                                <label class="form-check-label" for="arctic">Arctic</label>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-dark clr">Add</button>
                <br> <br>
            </form>
        </div>
    </div>